    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "# 1. Load dataset\n",
    "df = pd.read_csv(\"Downloads/titanic-competition-w-tensorflow-decision-forests.ipynb\")\n",
    "\n",
    "# 2. Display first and last rows\n",
    "print(\"First 5 rows:\")\n",
    "print(df.head())\n",
    "\n",
    "print(\"\\nLast 5 rows:\")\n",
    "print(df.tail())\n",
    "\n",
    "# 3. Number of rows and columns\n",
    "print(\"\\nNumber of rows:\", df.shape[0])\n",
    "print(\"Number of columns:\", df.shape[1])\n",
    "\n",
    "# 4. Dataset information\n",
    "print(\"\\nDataset Information:\")\n",
    "df.info()\n",
    "\n",
    "# 5. Column names and data types\n",
    "print(\"\\nColumn Names:\")\n",
    "print(df.columns)\n",
    "\n",
    "print(\"\\nData Types:\")\n",
    "print(df.dtypes)\n",
    "\n",
    "# 6. Separate numerical and categorical columns\n",
    "numerical = df.select_dtypes(include=np.number)\n",
    "categorical = df.select_dtypes(include=[\"object\", \"category\"])\n",
    "\n",
    "print(\"\\nNumerical Columns:\")\n",
    "print(numerical.columns.tolist())\n",
    "\n",
    "print(\"\\nCategorical Columns:\")\n",
    "print(categorical.columns.tolist())\n",
    "\n",
    "print(\"\\nNumber of Numerical Columns:\", numerical.shape[1])\n",
    "print(\"Number of Categorical Columns:\", categorical.shape[1])\n",
    "\n",
    "# 7. Count unique values and category frequencies\n",
    "print(\"\\nUnique Values in Each Column:\")\n",
    "print(df.nunique())\n",
    "\n",
    "print(\"\\nCategorical Value Counts:\")\n",
    "for col in categorical.columns:\n",
    "    print(\"\\n\", col)\n",
    "    print(df[col].value_counts(dropna=False))\n",
    "\n",
    "# 8. Missing values\n",
    "print(\"\\nMissing Values:\")\n",
    "print(df.isnull().sum())\n",
    "\n",
    "print(\"\\nTotal Missing Values:\", df.isnull().sum().sum())\n",
    "\n",
    "print(\"\\nMissing Value Percentage:\")\n",
    "print(df.isnull().mean() * 100)\n",
    "\n",
    "# 9. Mean, median, and mode\n",
    "print(\"\\nMean of Numerical Columns:\")\n",
    "print(numerical.mean())\n",
    "\n",
    "print(\"\\nMedian of Numerical Columns:\")\n",
    "print(numerical.median())\n",
    "\n",
    "print(\"\\nMode of Numerical Columns:\")\n",
    "print(numerical.mode().iloc[0])\n",
    "\n",
    "# 10. Descriptive statistics\n",
    "print(\"\\nNumerical Statistics:\")\n",
    "print(df.describe())\n",
    "\n",
    "print(\"\\nCategorical Statistics:\")\n",
    "print(df.describe(include=\"object\"))\n",
    "\n",
    "# 11. Matplotlib histogram\n",
    "if \"Age\" in df.columns:\n",
    "    plt.hist(df[\"Age\"].dropna(), bins=20)\n",
    "    plt.xlabel(\"Age\")\n",
    "    plt.ylabel(\"Frequency\")\n",
    "    plt.title(\"Distribution of Age\")\n",
    "    plt.show()\n",
    "\n",
    "# 12. Bar chart of categorical data\n",
    "if \"Sex\" in df.columns:\n",
    "    df[\"Sex\"].value_counts().plot(kind=\"bar\")\n",
    "    plt.xlabel(\"Sex\")\n",
    "    plt.ylabel(\"Count\")\n",
    "    plt.title(\"Passengers by Sex\")\n",
    "    plt.show()\n",
    "\n",
    "# 13. Survival count\n",
    "if \"Survived\" in df.columns:\n",
    "    df[\"Survived\"].value_counts().sort_index().plot(kind=\"bar\")\n",
    "    plt.xlabel(\"Survived (0 = No, 1 = Yes)\")\n",
    "    plt.ylabel(\"Count\")\n",
    "    plt.title(\"Survival Count\")\n",
    "    plt.show()\n",
    "\n",
    "# 14. Box plot to identify potential outliers\n",
    "if \"Age\" in df.columns:\n",
    "    plt.boxplot(df[\"Age\"].dropna())\n",
    "    plt.ylabel(\"Age\")\n",
    "    plt.title(\"Age Box Plot\")\n",
    "    plt.show()\n",
    "\n",
    "# 15. Scatter plot\n",
    "if \"Age\" in df.columns and \"Fare\" in df.columns:\n",
    "    plt.scatter(df[\"Age\"], df[\"Fare\"])\n",
    "    plt.xlabel(\"Age\")\n",
    "    plt.ylabel(\"Fare\")\n",
    "    plt.title(\"Age vs Fare\")\n",
    "    plt.show()\n",
    "\n",
    "# 16. Detect outliers using IQR\n",
    "print(\"\\nPotential Outliers in Numerical Columns:\")\n",
    "\n",
    "for col in numerical.columns:\n",
    "    Q1 = df[col].quantile(0.25)\n",
    "    Q3 = df[col].quantile(0.75)\n",
    "    IQR = Q3 - Q1\n",
    "\n",
    "    lower = Q1 - 1.5 * IQR\n",
    "    upper = Q3 + 1.5 * IQR\n",
    "\n",
    "    outliers = df[(df[col] < lower) | (df[col] > upper)]\n",
    "\n",
    "    print(col, \":\", len(outliers), \"potential outliers\")\n",
    "\n",
    "# 17. Check duplicate rows\n",
    "print(\"\\nNumber of Duplicate Rows:\")\n",
    "print(df.duplicated().sum())\n",
    "\n",
    "# 18. Correlation matrix\n",
    "print(\"\\nCorrelation Matrix:\")\n",
    "print(df.corr(numeric_only=True))\n",
    "\n",
    "# 19. Correlation heatmap\n",
    "plt.figure(figsize=(10, 6))\n",
    "sns.heatmap(df.corr(numeric_only=True), annot=True, cmap=\"coolwarm\")\n",
    "plt.title(\"Correlation Heatmap\")\n",
    "plt.show()\n",
    "\n",
    "# 20. Final summary\n",
    "print(\"\\nFinal Dataset Summary\")\n",
    "print(\"Rows:\", df.shape[0])\n",
    "print(\"Columns:\", df.shape[1])\n",
    "print(\"Numerical Columns:\", numerical.shape[1])\n",
    "print(\"Categorical Columns:\", categorical.shape[1])\n",
    "print(\"Missing Values:\", df.isnull().sum().sum())\n",
    "print(\"Duplicate Rows:\", df.duplicated().sum())\n"
   ]
